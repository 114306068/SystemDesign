# 複製成 .env 後依自己電腦的資料庫帳密修改（.env 不會被 commit）
# 預設對應 docker-compose.yml 的 MySQL
DB_URL=jdbc:mysql://127.0.0.1:3306/gig_radar?allowPublicKeyRetrieval=true&useSSL=false
DB_USER=gigradar
DB_PASSWORD=gigradar
SQL_ECHO=false

# 沒有 MySQL / Docker 時，可以改用 H2 檔案資料庫（資料存在 data/ 資料夾）：
# DB_URL=jdbc:h2:file:./data/gig_radar;MODE=MySQL
# DB_USER=sa
# DB_PASSWORD=
